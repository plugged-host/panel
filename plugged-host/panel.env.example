# /etc/calagopus/panel.env (root:calagopus 640). Placeholders only: real values live on the box.

DATABASE_URL="postgresql://calagopus:<password>@127.0.0.1:5432/calagopus"
DATABASE_MIGRATE=true

# Redis: its own DB number (never DB 0 on a shared Redis) and key prefix.
REDIS_URL="redis://127.0.0.1:6379/5"
REDIS_KEY_PREFIX="calagopus"

# Generated once (openssl rand -hex 32) and never changed: it encrypts stored secrets.
APP_ENCRYPTION_KEY="<random>"

BIND=127.0.0.1
PORT=8730
APP_PRIMARY=true
APP_LOG_DIRECTORY=/var/log/calagopus
APP_USE_DECRYPTION_CACHE=true
# nginx on the loopback, Cloudflare in front of it.
APP_TRUSTED_PROXIES="127.0.0.1/32,::1/128,<cloudflare ranges>"

# noprofit.space is set in Admin › Settings › noprofit.space (docs/noprofit.md). Releases before
# 2026-10-23 read NOPROFIT_* variables here; they fill those settings in until they are saved once.

# plugged.host: the Windows app, downloadable by admins only (docs/features/app.md). Set on dev,
# never on prod. The file is served by /api/client/app/download; the More row appears only when it
# exists and the account is an admin.
PLUGGED_APP_INSTALLER=/var/lib/calagopus/app/plugged.host-Setup-3.1.0.exe
PLUGGED_APP_VERSION=3.1.0
