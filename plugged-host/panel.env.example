# /etc/calagopus/panel.env (root:calagopus 640). Placeholders only: real values live on the box.

DATABASE_URL="postgresql://calagopus:<password>@127.0.0.1:5432/calagopus"
DATABASE_MIGRATE=true

# The box's shared Redis, never DB 0 (that one holds the Pelican panels' sessions and queues).
REDIS_URL="redis://127.0.0.1:6379/5"
REDIS_KEY_PREFIX="calagopus"

# Generated once (openssl rand -hex 32) and never changed: it encrypts stored secrets.
APP_ENCRYPTION_KEY="<random>"

BIND=127.0.0.1
PORT=8730
APP_PRIMARY=true
APP_LOG_DIRECTORY=/var/log/calagopus
APP_USE_DECRYPTION_CACHE=true
# nginx on the loopback, Cloudflare in front of it.
APP_TRUSTED_PROXIES="127.0.0.1/32,::1/128,<cloudflare ranges>"

# noprofit.space (optional; without NOPROFIT_ACCOUNTS_URL + NOPROFIT_SSO_SECRET the panel signs
# people in on its own). The secrets are the accounts app's NOPROFIT_CALAGOPUS_SSO_SECRET and
# NOPROFIT_CALAGOPUS_SECRET.
NOPROFIT_ACCOUNTS_URL="https://accounts.noprofit.space"
NOPROFIT_SSO_SECRET="<32+ characters>"
NOPROFIT_API_SECRET="<32+ characters>"
# Only noprofit.space admins may sign in (while the panel is not open to everyone).
NOPROFIT_ADMINS_ONLY=true
# NOPROFIT_SSO_CLIENT=plugged-host-calagopus
# NOPROFIT_SSO_CALLBACK=https://calagopus.plugged.host/api/auth/noprofit/callback
# A first sign-in links the panel user with the same email (default); false refuses instead.
# NOPROFIT_LINK_BY_EMAIL=false
